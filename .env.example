# ---------------------------------------------------------------------------
# Pflicht: Finnhub API-Key (Free-Tier reicht)
# Registrierung: https://finnhub.io/register  ->  Dashboard -> API Key
# Ohne gueltigen Key startet der Container nicht.
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Host-Port und Bind-Adresse.
#   127.0.0.1  nur lokal auf dem Server, Zugriff per SSH-Tunnel (siehe README)
#   0.0.0.0    auf allen Schnittstellen - dann MUSS ALLOWED_IPS gesetzt sein,
#              sonst verweigert der Container den Start.
BIND_ADDR=127.0.0.1
HOST_PORT=8000

# Wer darf zugreifen, wenn BIND_ADDR nicht 127.0.0.1 ist.
# Einzeladressen und CIDR-Bereiche, komma-getrennt:
#   ALLOWED_IPS=203.0.113.7
#   ALLOWED_IPS=203.0.113.7,198.51.100.0/24
# Localhost ist immer erlaubt (der Healthcheck laeuft im Container selbst).
# Entschieden wird anhand der TCP-Gegenstelle; X-Forwarded-For wird bewusst
# ignoriert, weil den Kopf ohne Reverse-Proxy jeder selbst setzen kann.
# Die aktuelle eigene IP zeigt: curl -s https://ifconfig.me
ALLOWED_IPS=

# ---------------------------------------------------------------------------
# Optional: KI-Nachrichtenlage auf dem Steckbrief
# Beide Keys noetig; fehlt einer, ist die Funktion aus. Nach Aenderung 'make up'.
#   Firecrawl (Nachrichtensuche):  https://www.firecrawl.dev  -> API Keys
#   Mistral (Zusammenfassung):     https://console.mistral.ai -> API Keys
# Die Keys gehoeren nur hierher - nicht in config.yaml, nicht in einen Chat.
# ---------------------------------------------------------------------------
FIRECRAWL_API_KEY=
MISTRAL_API_KEY=
# Modell fuer die Zusammenfassung; leer = Vorgabe aus config.yaml
# (mistral-small-latest). Groesser und teurer: mistral-medium-latest.
MISTRAL_MODEL=

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true = einmaliger Pipeline-Lauf direkt beim Containerstart
RUN_ON_STARTUP=false

# UID/GID, mit denen der Prozess im Container laeuft. Steuert, wem ./data/poc.db
# auf dem Host gehoert. setup.sh traegt hier automatisch die eigene ID ein.
APP_UID=1000
APP_GID=1000
