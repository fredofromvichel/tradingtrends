# ---------------------------------------------------------------------------
# Pflicht: Finnhub API-Key (Free-Tier reicht)
# Registrierung: https://finnhub.io/register  ->  Dashboard -> API Key
# Ohne gueltigen Key startet der Container nicht.
# ---------------------------------------------------------------------------
FINNHUB_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Host-Port und Bind-Adresse. 127.0.0.1 = nur lokal auf dem Server erreichbar,
# Zugriff von aussen per SSH-Tunnel (siehe README). NICHT auf 0.0.0.0 stellen,
# solange keine Authentifizierung vorgeschaltet ist.
BIND_ADDR=127.0.0.1
HOST_PORT=8000

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# true = einmaliger Pipeline-Lauf direkt beim Containerstart
RUN_ON_STARTUP=false

# UID/GID, mit denen der Prozess im Container laeuft. Steuert, wem ./data/poc.db
# auf dem Host gehoert. setup.sh traegt hier automatisch die eigene ID ein.
APP_UID=1000
APP_GID=1000
